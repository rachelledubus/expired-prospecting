# Password for the single login gate (change this)
PORTAL_PASSWORD=change-me

# Long random string — used to sign the session cookie. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# or any password generator. Must be kept secret.
PORTAL_SESSION_SECRET=replace-with-a-long-random-string

# Tracerfy API
# Sandbox (no credits used, fake data) — use this until you're ready to go live:
TRACERFY_API_BASE=https://mock.tracerfy.com/v1/api
# Production:
# TRACERFY_API_BASE=https://tracerfy.com/v1/api
TRACERFY_API_KEY=your-tracerfy-bearer-token

# Notion — pushes matched leads into your real "Clients / Leads" CRM database,
# and watchlist rows (price reductions / stale listings) into "Property Research".
# 1. Create an internal integration at notion.so/my-integrations (Insert + Update content capability).
# 2. Copy its "Internal Integration Secret" below.
# 3. Open BOTH "Clients / Leads" and "Property Research" in Notion -> "..." menu -> Connections -> add this integration to each.
NOTION_API_KEY=your-notion-integration-secret
NOTION_LEADS_DATABASE_ID=9f7f408a-fdce-82f5-a49c-01dfb37a4c4c
NOTION_PROPERTY_RESEARCH_DATABASE_ID=5f4009da-260f-47ca-8120-0519d9134afe
